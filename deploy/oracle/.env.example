# /etc/lilush-bot.env  — chmod 600, root-owned, referenced by
# lilush-bot.service. Copy this file to /etc/lilush-bot.env on the
# Oracle VM and fill in the real values. Never commit the real one
# to git.
#
# Most of these match the Render env vars 1:1 — the bot is portable
# between platforms (see DEPLOY.md). Required keys are marked [REQ];
# everything else has a working default.

# ─── core ──────────────────────────────────────────────────────────────

# [REQ] Telegram bot token from @BotFather.
BOT_TOKEN=000000000:replace-with-real-token

# Which farm role this process plays (see bot/persona.py).
# Default «boss» = single-bot deploy, keep this on Oracle unless you
# explicitly split workers out.
BOT_PERSONA=boss

# Polling (default, works everywhere incl. behind NAT) or webhook
# (needs PUBLIC_URL pointing at this VM's HTTPS).
BOT_MODE=polling

# Internal aiohttp port. nginx.conf reverse-proxies 443 → this port.
PORT=8080

# ─── public URL ────────────────────────────────────────────────────────

# [REQ-on-Oracle] Either PUBLIC_URL OR ORACLE_PUBLIC_HOST must be
# set so addons that mint user-visible links (Fable5, Test, future
# Master Room) know how to render them. PUBLIC_URL wins — it's the
# explicit override. ORACLE_PUBLIC_HOST is a friendly Oracle-only
# alias (accepts bare hostnames; gets https:// prepended).
PUBLIC_URL=https://bot.example.com
# ORACLE_PUBLIC_HOST=bot.example.com

# ─── owners / access ───────────────────────────────────────────────────

# Telegram user IDs allowed to use the bot. Owner is set via /start
# the first time so this can stay empty for a single-user deploy.
ALLOWED_USER_IDS=

# ─── LLM providers ─────────────────────────────────────────────────────

# Pick at least one. The bot prefers OpenRouter (cheap free models),
# falls back to Anthropic / OpenAI if configured.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default chat model.
MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated fallback list (used when MODEL returns 429 / 5xx).
FALLBACK_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-coder:free,minimax/minimax-m2.5:free

# ─── data dir ──────────────────────────────────────────────────────────

# Where state.json + uploaded artefacts live. Override to point at
# Oracle's block volume mount so data survives instance rebuilds.
DATA_DIR=/var/lib/lilush-bot

# ─── self-ping ─────────────────────────────────────────────────────────

# Oracle Free Tier doesn't idle the VM (unlike Render Free), so the
# keep-alive loop can be disabled entirely. Set to 0 to opt out;
# leave empty to use the default randomised cadence.
KEEP_ALIVE_INTERVAL=0
# KEEP_ALIVE_URL=  # only if you really need an internal-only ping target

# ─── deAPI / media stack (optional) ────────────────────────────────────

# Used by the 🎬 «Мозг для видео и фото» feature. Skip if unused.
DEAPI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# ─── editor / analyzer (optional) ──────────────────────────────────────

# v2 / v6 editor pipeline knobs. Defaults are sensible; only set
# these to override.
# EDITOR_VERSION=v1
# EDITOR_PROFILE=light
