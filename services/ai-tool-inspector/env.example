# Переименуй этот файл в .env перед запуском

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Получи токен у @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Твой Chat ID (открой https://api.telegram.org/bot<TOKEN>/getUpdates после /start)
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=3001
SERVICE_NAME=local
SERVICE_URL=http://localhost:3001

# ── Бот (если запускается отдельно) ──────────────────────────────────────────
DEFAULT_SERVER_URL=http://localhost:3001

# ── AI API ключи (для чата в боте — POST /api/chat) ─────────────────────────
# Anthropic (Claude Sonnet / Opus)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o / GPT-4.1)
# OPENAI_API_KEY=sk-...

# Google (Gemini 2.5 Pro)
# GEMINI_API_KEY=AIza...

# Mistral Large
# MISTRAL_API_KEY=...

# xAI (Grok 3)
# XAI_API_KEY=xai-...

# DeepSeek R2
# DEEPSEEK_API_KEY=sk-...
