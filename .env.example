# === Required ===
# Telegram bot token from @BotFather
BOT_TOKEN=

# Anthropic API key for AI features
ANTHROPIC_API_KEY=

# === Access control ===
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=

# === Optional ===
# Directory for runtime data (defaults to ./data)
DATA_DIR=./data

# Bot mode / persona
BOT_MODE=
BOT_PERSONA=

# DeAPI keys (media features)
DEAPI_API_KEY=
DEAPI_KEY=

# Agent limits
AGENT_MAX_STEPS=
AGENT_MAX_TOKENS=

# === Персональные данные и синхронизация (ЧАСТЬ 18) — всё опционально ===
# Без этих переменных бот работает штатно на локальном диске (/data).

# PostgreSQL для синхронизации: Neon / Yandex Managed PostgreSQL / любой
# совместимый. Стандартный DSN. Секрет — только в env, никогда в state.json.
# Пример: postgresql://user:password@host.neon.tech:5432/mydb?sslmode=require
DATABASE_URL=

# S3-совместимое хранилище крупных файлов (Yandex Object Storage и т.п.)
SYNC_S3_ENDPOINT=
SYNC_S3_BUCKET=
SYNC_S3_ACCESS_KEY_ID=
SYNC_S3_SECRET_ACCESS_KEY=
SYNC_S3_REGION=

# Master key для envelope encryption секретов (base64). В env лежит САМ
# ключ; в state.json — максимум имя этой переменной (паттерн token_ref).
SYNC_MASTER_KEY=
